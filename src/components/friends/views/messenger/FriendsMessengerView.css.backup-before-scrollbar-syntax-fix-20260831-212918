/* ------------------------------------------------------------------------
   1. Modern scrollbar - fully override classic Habbo scrollbar
   ------------------------------------------------------------------------ */

.phone-messenger-window .chat-messages {
    scrollbar-width: thin !important;
    scrollbar-color: #9ca4ac transparent !important;
}

/* Explicitly kill classic up/down scrollbar buttons */
.phone-messenger-window .chat-messages::-webkit-scrollbar-button,
.has-classic-scrollbar .phone-messenger-window .chat-messages::-webkit-scrollbar-button,
.has-classic-scrollbar .phone-messenger-window .chat-messages::-webkit-scrollbar-button:single-button,
.has-classic-scrollbar .phone-messenger-window .chat-messages::-webkit-scrollbar-button:single-button:vertical,
.has-classic-scrollbar .phone-messenger-window .chat-messages::-webkit-scrollbar-button:single-button:vertical:decrement,
.has-classic-scrollbar .phone-messenger-window .chat-messages::-webkit-scrollbar-button:single-button:vertical:increment {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
    min-width: 0 !important;
    min-height: 0 !important;
    background: none !important;
    background-image: none !important;
    border: 0 !important;
}

/* Narrow native-style scrollbar */
.phone-messenger-window .chat-messages::-webkit-scrollbar,
.has-classic-scrollbar .phone-messenger-window .chat-messages::-webkit-scrollbar {
    width: 7px !important;
    height: 7px !important;
    background: transparent !important;
}

.phone-messenger-window .chat-messages::-webkit-scrollbar-track,
.has-classic-scrollbar .phone-messenger-window .chat-messages::-webkit-scrollbar-track,
.has-classic-scrollbar .phone-messenger-window .chat-messages::-webkit-scrollbar-track:vertical {
    margin: 5px 0 !important;
    border: 0 !important;
    border-radius: 10px !important;
    background: transparent !important;
    background-image: none !important;
    box-shadow: none !important;
}

.phone-messenger-window .chat-messages::-webkit-scrollbar-thumb,
.has-classic-scrollbar .phone-messenger-window .chat-messages::-webkit-scrollbar-thumb,
.has-classic-scrollbar .phone-messenger-window .chat-messages::-webkit-scrollbar-thumb:vertical {
    min-height: 28px !important;
    border: 2px solid transparent !important;
    border-radius: 10px !important;
    background: #9ca4ac !important;
    background-image: none !important;
    background-clip: padding-box !important;
    box-shadow: none !important;
}

.phone-messenger-window .chat-messages::-webkit-scrollbar-thumb:hover,
.has-classic-scrollbar .phone-messenger-window .chat-messages::-webkit-scrollbar-thumb:vertical:hover {
    background: #858e97 !important;
    background-image: none !important;
    background-clip: padding-box !important;
}

.phone-messenger-window .chat-messages::-webkit-scrollbar-thumb:active,
.has-classic-scrollbar .phone-messenger-window .chat-messages::-webkit-scrollbar-thumb:vertical:active {
    background: #737c85 !important;
    background-image: none !important;
    background-clip: padding-box !important;
}

/* Remove any classic decorative stripes/pseudo-elements */
.has-classic-scrollbar .phone-messenger-window .chat-messages::-webkit-scrollbar-thumb::before,
.has-classic-scrollbar .phone-messenger-window .chat-messages::-webkit-scrollbar-thumb::after {
    display: none !important;
    content: none !important;
}

