@font-face {
    font-family: MessengerUbuntu;
    src: url("@/assets/webfonts/Ubuntu.ttf") format("truetype");
    font-style: normal;
    font-weight: 400;
    font-display: block;
}

@font-face {
    font-family: MessengerUbuntu;
    src: url("@/assets/webfonts/Ubuntu-b.ttf") format("truetype");
    font-style: normal;
    font-weight: 700;
    font-display: block;
}

.messenger-window,
.messenger-window *:not(.avatar-image) {
    box-sizing: border-box;
}

.messenger-window {
    position: relative;
    width: 282px;
    min-width: 282px;
    height: 385px;
    min-height: 275px;
    max-width: calc(100vw - 10px);
    max-height: calc(100vh - 10px);
    overflow: hidden;
    resize: both;
    border: 1px solid #777771;
    border-radius: 5px;
    background: #e4e4e4;
    box-shadow: inset 0 0 0 1px #fff, 0 2px 5px rgba(0, 0, 0, .42);
    color: #000;
    font-family: MessengerUbuntu, Arial, sans-serif;
    font-kerning: normal;
    font-synthesis: none;
    image-rendering: pixelated;
    text-rendering: geometricPrecision;
    text-shadow: none;
}

.messenger-window button,
.messenger-window input {
    font-family: MessengerUbuntu, Arial, sans-serif;
}

.messenger-window button {
    cursor: pointer;
}

.messenger-window .messenger-drag {
    position: absolute;
    z-index: 1;
    inset: 0 0 auto;
    height: 36px;
    cursor: move;
}

.messenger-window .messenger-open-title {
    position: absolute;
    top: 11px;
    left: 9px;
    height: 15px;
    overflow: hidden;
    color: #000;
    font-size: 10px;
    font-weight: 700;
    line-height: 14px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.messenger-window .messenger-minimize,
.messenger-window .messenger-btn.close-btn {
    width: 20px;
    min-width: 20px;
    height: 20px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: url("@/assets/images/friends/swf/illumina_light_button_frame_minimize.png") 0 0 / auto 20px no-repeat;
    color: transparent;
}

.messenger-window .messenger-minimize {
    position: absolute;
    z-index: 3;
    top: 8px;
    right: 15px;
}

.messenger-window .messenger-minimize:hover,
.messenger-window .messenger-btn.close-btn:hover { background-position: -52px 0; }
.messenger-window .messenger-minimize:active,
.messenger-window .messenger-btn.close-btn:active { background-position: -26px 0; }

.messenger-window .messenger-avatar-navigation {
    position: absolute;
    top: 36px;
    right: 1px;
    left: 1px;
    display: flex;
    height: 35px;
    align-items: stretch;
}

.messenger-window .messenger-avatar-bar {
    position: static;
    display: flex;
    min-width: 0;
    height: 35px;
    flex: 1 1 auto;
    padding: 0 !important;
    background: transparent !important;
    gap: 0;
    overflow: hidden;
}

.messenger-window .messenger-avatar-scroll {
    position: relative;
    width: 15px;
    min-width: 15px;
    height: 35px;
    padding: 0;
    border: 0;
    background-color: transparent;
    background-position: center;
    background-repeat: no-repeat;
}

.messenger-window .messenger-avatar-scroll.left {
    background-image: url("@/assets/images/friends/swf/arrow_right_black.png");
    transform: scaleX(-1);
}

.messenger-window .messenger-avatar-scroll.right {
    background-image: url("@/assets/images/friends/swf/arrow_right_black.png");
}

.messenger-window .messenger-avatar-scroll:disabled {
    visibility: hidden;
}

.messenger-window .messenger-avatar-tab,
.messenger-window .messenger-avatar-tab.active {
    position: relative;
    width: 35px !important;
    min-width: 35px !important;
    height: 35px !important;
    padding: 0 !important;
    border: 1px solid transparent !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    overflow: hidden;
}

.messenger-window .messenger-avatar-tab.active {
    border-color: #c5c5c5 !important;
    background: #ebebeb !important;
    box-shadow: inset 1px 1px 0 #fff !important;
}

.messenger-window .messenger-avatar-tab .avatar-image.compact-head {
    position: absolute !important;
    inset: 0 !important;
    width: 35px !important;
    height: 35px !important;
    margin: 0 !important;
    background-position: center !important;
    background-size: 35px 35px !important;
    image-rendering: auto !important;
    transform: none !important;
}

.messenger-window .messenger-avatar-tab.unread::after {
    position: absolute;
    z-index: 2;
    top: 6px;
    right: 3px;
    width: 13px;
    height: 12px;
    background: url("@/assets/images/friends/chat-indicator.svg") no-repeat;
    content: "";
}

.messenger-window .messenger-thread-header {
    position: absolute;
    top: 80px;
    right: 9px;
    left: 8px;
    height: 31px;
    padding: 0;
    background: #e4e4e4;
}

.messenger-window .messenger-thread-name {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    width: 100%;
    height: 14px;
    min-width: 0;
    align-items: flex-start;
    overflow: hidden;
    color: #4a4a4a;
    font-size: 10px;
    font-weight: 700;
    line-height: 14px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.messenger-window .messenger-thread-name::after {
    height: 1px;
    min-width: 16px;
    flex: 1;
    margin: 7px 0 0 5px;
    background: #b8b8b8;
    content: "";
}

.messenger-window .messenger-actions {
    position: absolute;
    top: 13px;
    right: 0;
    left: 0;
    display: flex;
    height: 20px;
    align-items: center;
    gap: 4px;
}

.messenger-window .messenger-btn {
    height: 20px;
    min-height: 20px;
    padding: 0 6px;
    border: 5px solid transparent;
    border-image: url("@/assets/images/friends/swf/illumina_light_button_plain_default.png") 5 fill stretch;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    color: #000;
    font-size: 10px;
    font-weight: 700;
    line-height: 10px;
}

.messenger-window .messenger-btn:hover {
    border-image: url("@/assets/images/friends/swf/illumina_light_button_plain_hover.png") 5 fill stretch;
}

.messenger-window .messenger-btn:active {
    border-image: url("@/assets/images/friends/swf/illumina_light_button_plain_pressed.png") 5 fill stretch;
}

.messenger-window .messenger-btn.icon-btn {
    padding: 0;
}

.messenger-window .messenger-btn.icon-btn.follow { width: 21px; min-width: 21px; }
.messenger-window .messenger-btn.icon-btn.profile { width: 30px; min-width: 30px; }

.messenger-window .messenger-btn.icon-btn::before {
    display: block;
    margin: auto;
    background-position: center;
    background-repeat: no-repeat;
    content: "";
}

.messenger-window .messenger-btn.icon-btn.follow::before {
    width: 9px;
    height: 10px;
    background-image: url("@/assets/images/friends/swf/messenger_visit_icon.png");
}

.messenger-window .messenger-btn.icon-btn.profile::before {
    width: 16px;
    height: 12px;
    background-image: url("@/assets/images/friends/swf/messenger_profile_icon.png");
}

.messenger-window .messenger-btn.danger {
    width: auto;
    min-width: 0;
    flex: 1 1 auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.messenger-window .messenger-btn.close-btn {
    margin-left: auto;
    border-image: none;
    background-image: url("@/assets/images/friends/swf/illumina_light_button_frame_close.png");
}

.messenger-window .chat-messages {
    position: absolute;
    top: 122px;
    right: 9px;
    bottom: 49px;
    left: 7px;
    padding: 4px 1px 4px 0;
    overflow-x: hidden;
    overflow-y: auto;
    background: #e4e4e4;
}

.messenger-window:has(.messenger-typing-indicator) .chat-messages {
    bottom: 53px;
}

.messenger-window .messenger-message-row {
    display: flex;
    width: 259px;
    max-width: 100%;
    min-height: 65px;
    align-items: flex-start;
    margin: 0;
    gap: 0;
}

.messenger-window .message-avatar {
    position: relative;
    width: 52px;
    min-width: 52px;
    height: 56px;
    flex: 0 0 52px;
    overflow: hidden;
}

.messenger-window .message-avatar .avatar-image {
    position: absolute !important;
    top: -21px !important;
    left: -19px !important;
    width: 90px !important;
    height: 130px !important;
    margin: 0 !important;
    background-position: 0 0 !important;
    background-size: auto !important;
    image-rendering: pixelated !important;
    transform: none !important;
}

.messenger-window .messenger-message-body {
    display: flex;
    width: 207px;
    max-width: calc(100% - 52px);
    min-width: 0;
    flex: 0 0 207px;
    flex-direction: column;
    align-items: stretch;
    padding-top: 15px;
}

.messenger-window .messenger-message-name {
    height: 15px;
    color: #555;
    font-size: 10px;
    font-weight: 700;
    line-height: 15px;
}

.messenger-window .messenger-message-bubble {
    position: relative;
    width: 100%;
    min-height: 18px;
    padding: 2px 6px 0;
    border: solid transparent;
    border-width: 5px 4px 7px;
    border-image: url("@/assets/images/friends/chat-bubble-frame.svg") 5 4 7 4 fill stretch;
    background: transparent;
    color: #000;
    overflow-wrap: break-word;
    font-size: 11px;
    line-height: 13px;
}

.messenger-window .messenger-message-bubble::after {
    position: absolute;
    top: 9px;
    width: 5px;
    height: 10px;
    background: url("@/assets/images/friends/chat-bubble-arrow.svg") no-repeat;
    content: "";
}

.messenger-window .messenger-message-row:not(.own) .messenger-message-bubble::after {
    right: -5px;
}

.messenger-window .messenger-message-row.own .messenger-message-bubble::after {
    left: -5px;
    transform: scaleX(-1);
}

.messenger-window .messenger-message-time {
    width: 131px;
    height: 16px;
    color: #555;
    font-size: 10px;
    line-height: 16px;
}

.messenger-window .messenger-translation-block + .messenger-translation-block {
    margin-top: 5px;
}

.messenger-window .messenger-notification {
    display: flex;
    min-height: 50px;
    align-items: center;
    margin-bottom: 4px;
    padding: 4px 8px;
    border: 1px solid #c4c4c4;
    border-radius: 4px;
    background: #d1efde;
    gap: 8px;
    font-size: 10px;
}

.messenger-window .messenger-notification img {
    width: auto;
    min-width: 25px;
    height: auto;
    image-rendering: pixelated;
}

.messenger-window .messenger-status-notification {
    margin: 6px 0;
    color: #666;
    font-size: 10px;
    text-align: center;
}

.messenger-window .messenger-typing-indicator {
    position: absolute;
    right: 10px;
    bottom: 39px;
    left: 8px;
    height: 14px;
    color: #666;
    font-size: 9px;
    line-height: 14px;
}

.messenger-window .messenger-input-row {
    position: absolute;
    right: 9px;
    bottom: 7px;
    left: 7px;
    display: flex;
    height: 30px;
    align-items: center;
    padding: 0;
    background: #e4e4e4;
    gap: 3px;
}

.messenger-window .messenger-input-row input {
    width: auto;
    min-width: 0;
    height: 29px;
    min-height: 29px;
    flex: 1 1 auto;
    padding: 4px 7px;
    border: 1px solid #b8b8b8;
    border-radius: 5px;
    outline: 0;
    background: #fff;
    color: #555;
    font-size: 11px;
}

.messenger-window .messenger-btn.send {
    width: 55px;
    min-width: 55px;
    height: 28px;
}

.messenger-window .messenger-btn.habbicon {
    display: flex;
    width: 30px;
    min-width: 30px;
    height: 28px;
    align-items: center;
    justify-content: center;
    padding: 0;
}

.messenger-window .messenger-btn.habbicon img {
    display: block;
    max-width: 24px;
    max-height: 24px;
}

.messenger-window .messenger-habbicon-picker {
    position: absolute;
    z-index: 20;
    right: 13px;
    bottom: 41px;
    box-sizing: border-box;
    width: 256px;
    padding: 0 1px 1px;
    border-style: solid;
    border-width: 10px 5px 5px;
    border-color: transparent;
    border-image: url("@/assets/images/friends/swf/illumina_light_balloon.png") 10 5 5 5 fill stretch;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    image-rendering: pixelated;
}

.messenger-window .messenger-habbicon-controls {
    display: flex;
    width: 242px;
    height: 28px;
    margin: 0 0 7px;
    gap: 9px;
}

.messenger-window .messenger-habbicon-search {
    position: relative;
    box-sizing: border-box;
    width: 143px;
    height: 24px;
    margin-top: 4px;
    border-style: solid;
    border-width: 8px 5px 4px;
    border-color: transparent;
    border-image: url("@/assets/images/friends/swf/illumina_light_input_fill.png") 8 5 4 5 fill stretch;
    background: transparent;
}

.messenger-window .messenger-habbicon-search input {
    position: absolute;
    top: -4px;
    left: 1px;
    width: 111px;
    height: 17px;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    box-shadow: none;
    color: #333;
    font-size: 11px;
    line-height: 17px;
}

.messenger-window .messenger-habbicon-search span {
    position: absolute;
    top: -4px;
    left: 1px;
    width: 111px;
    height: 17px;
    color: #888;
    font-size: 11px;
    line-height: 17px;
    pointer-events: none;
}

.messenger-window .messenger-habbicon-search button {
    position: absolute;
    top: -4px;
    right: -1px;
    width: 17px;
    height: 17px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent url("@/assets/images/habbicons/slices/promo-arrow-close.png") center no-repeat;
    opacity: .7;
    image-rendering: pixelated;
}

.messenger-window .messenger-btn.messenger-habbicon-get-more {
    width: 90px;
    min-width: 90px;
    height: 24px;
    margin-top: 4px;
    padding: 0;
    font-size: 10px;
    font-weight: 700;
    line-height: 14px;
}

.messenger-window .messenger-habbicon-scroll {
    width: 244px;
    margin-top: 0;
    padding-right: 0;
    overflow-x: hidden;
    overflow-y: auto;
}

.messenger-window .messenger-habbicon-scroll section {
    width: 230px;
    margin: 0 0 4px;
}

.messenger-window .messenger-habbicon-scroll strong {
    display: block;
    height: 18px;
    margin: 0 0 2px;
    color: #111;
    font-size: 10px;
    font-weight: 400;
    line-height: 18px;
}

.messenger-window .messenger-habbicon-grid {
    display: grid;
    width: 230px;
    grid-template-columns: repeat(5, 44px);
    gap: 2px;
}

.messenger-window .messenger-habbicon-grid button,
.messenger-window .messenger-habbicon-grid .empty {
    position: relative;
    box-sizing: border-box;
    width: 44px;
    height: 45px;
    min-height: 45px;
    padding: 0;
    overflow: hidden;
    border-style: solid;
    border-width: 4px 4px 5px;
    border-color: transparent;
    border-image: url("@/assets/images/friends/swf/illumina_light_border_raised_edge.png") 4 4 5 4 stretch;
    border-radius: 0;
    background: rgba(255, 255, 255, .85);
    box-shadow: none;
    image-rendering: pixelated;
}

.messenger-window .messenger-habbicon-grid .empty {
    background: rgba(221, 221, 221, .4);
}

.messenger-window .messenger-habbicon-grid button:hover {
    background: #eeeeee;
}

.messenger-window .messenger-habbicon-grid button span {
    position: absolute;
    top: 2px;
    left: 2px;
    display: block;
    width: 40px;
    height: 40px;
    overflow: hidden;
    background-repeat: no-repeat;
    image-rendering: pixelated;
    pointer-events: none;
}

.messenger-window .messenger-habbicon-empty {
    display: flex;
    width: 256px;
    height: 96px;
    margin: -3px -6px 0;
    align-items: center;
    justify-content: center;
    color: rgba(0, 0, 0, .83);
    font-size: 11px;
    text-align: center;
}

.messenger-window .messenger-message-bubble:has(.messenger-habbicon-message) {
    padding: 7px 0;
}

.messenger-window .messenger-habbicon-message {
    display: block;
    width: 80px;
    height: 80px;
    margin-left: 10px;
    overflow: hidden;
    background-repeat: no-repeat;
    image-rendering: pixelated;
}

.messenger-window .messenger-habbicon-message.mirrored {
    transform: scaleX(-1);
}


/* ========================================================================
   PHONE MESSENGER
   Presentation-only skin for FriendsMessengerView.
   ======================================================================== */

.phone-messenger-window {
    width: 390px;
    min-width: 350px;
    height: 650px;
    min-height: 520px;
    max-width: calc(100vw - 16px);
    max-height: calc(100vh - 16px);
    resize: both;
    overflow: hidden;
    border: 7px solid #17191d;
    border-radius: 38px;
    background: #f4f6f8;
    box-shadow:
        0 18px 45px rgba(0, 0, 0, .38),
        inset 0 0 0 1px rgba(255, 255, 255, .14);
    color: #17191d;
    image-rendering: auto;
}

/* phone speaker / dynamic-island style detail */
.phone-messenger-window::before {
    position: absolute;
    z-index: 30;
    top: 8px;
    left: 50%;
    width: 92px;
    height: 19px;
    border-radius: 20px;
    background: #17191d;
    content: "";
    pointer-events: none;
    transform: translateX(-50%);
}

.phone-messenger-window .messenger-drag {
    z-index: 25;
    height: 34px;
    cursor: move;
}

.phone-messenger-window .messenger-open-title {
    top: 12px;
    left: 22px;
    z-index: 26;
    max-width: 95px;
    color: #59636e;
    font-size: 10px;
    line-height: 15px;
}

.phone-messenger-window .messenger-minimize {
    z-index: 31;
    top: 10px;
    right: 18px;
    width: 24px;
    min-width: 24px;
    height: 24px;
    border: 0;
    border-radius: 50%;
    background: #e2e6ea;
    color: #30363d;
}

.phone-messenger-window .messenger-minimize::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 10px;
    height: 2px;
    border-radius: 2px;
    background: #30363d;
    content: "";
    transform: translate(-50%, -50%);
}

.phone-messenger-window .messenger-minimize:hover {
    background: #d3d8dd;
}

.phone-messenger-window .messenger-minimize:active {
    background: #c6ccd2;
}


/* ------------------------------------------------------------------------
   Conversation strip
   ------------------------------------------------------------------------ */

.phone-messenger-window .messenger-avatar-navigation {
    position: absolute;
    z-index: 10;
    top: 37px;
    right: 12px;
    left: 12px;
    height: 54px;
    padding: 5px 4px;
    border-bottom: 1px solid #e1e5e9;
    background: #fff;
    align-items: center;
}

.phone-messenger-window .messenger-avatar-bar {
    height: 44px;
    align-items: center;
    justify-content: flex-start;
    gap: 5px;
}

.phone-messenger-window .messenger-avatar-scroll {
    width: 20px;
    min-width: 20px;
    height: 44px;
    border: 0;
    opacity: .6;
}

.phone-messenger-window .messenger-avatar-scroll:hover {
    opacity: 1;
}

.phone-messenger-window .messenger-avatar-tab,
.phone-messenger-window .messenger-avatar-tab.active {
    width: 42px !important;
    min-width: 42px !important;
    height: 42px !important;
    border: 2px solid transparent !important;
    border-radius: 50% !important;
    background: #edf0f3 !important;
    overflow: hidden;
}

.phone-messenger-window .messenger-avatar-tab.active {
    border-color: #4f8cff !important;
    background: #e9f1ff !important;
    box-shadow: 0 0 0 2px rgba(79, 140, 255, .16) !important;
}

.phone-messenger-window .messenger-avatar-tab .avatar-image.compact-head {
    inset: 2px !important;
    width: 34px !important;
    height: 34px !important;
    border-radius: 50%;
    background-size: 34px 34px !important;
    image-rendering: auto !important;
}

.phone-messenger-window .messenger-avatar-tab.unread::after {
    top: 0;
    right: 0;
    width: 10px;
    height: 10px;
    border: 2px solid #fff;
    border-radius: 50%;
    background: #ff4d67;
    content: "";
}


/* ------------------------------------------------------------------------
   Active conversation header
   ------------------------------------------------------------------------ */

.phone-messenger-window .messenger-thread-header {
    position: absolute;
    z-index: 9;
    top: 91px;
    right: 0;
    left: 0;
    height: 70px;
    padding: 8px 13px;
    border-bottom: 1px solid #dde2e7;
    background: rgba(255, 255, 255, .98);
}

.phone-messenger-window .phone-conversation-identity {
    position: absolute;
    top: 7px;
    left: 14px;
    display: flex;
    max-width: calc(100% - 150px);
    height: 50px;
    align-items: center;
    gap: 9px;
}

.phone-messenger-window .phone-conversation-avatar {
    position: relative;
    width: 44px;
    min-width: 44px;
    height: 44px;
    overflow: hidden;
    border-radius: 50%;
    background: #e8edf2;
}

.phone-messenger-window .phone-conversation-avatar .avatar-image.compact-head {
    position: absolute !important;
    inset: 3px !important;
    width: 38px !important;
    height: 38px !important;
    margin: 0 !important;
    background-position: center !important;
    background-size: 38px 38px !important;
    image-rendering: auto !important;
}

.phone-messenger-window .phone-conversation-text {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
}

.phone-messenger-window .messenger-thread-name {
    position: static;
    display: block;
    width: auto;
    height: auto;
    overflow: hidden;
    color: #17191d;
    font-size: 14px;
    font-weight: 700;
    line-height: 18px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.phone-messenger-window .messenger-thread-name::after {
    display: none;
}

.phone-messenger-window .phone-conversation-status {
    display: block;
    max-width: 150px;
    overflow: hidden;
    color: #7a858f;
    font-size: 9px;
    line-height: 13px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.phone-messenger-window .messenger-actions {
    position: absolute;
    top: 20px;
    right: 12px;
    left: auto;
    display: flex;
    width: auto;
    height: 30px;
    align-items: center;
    gap: 5px;
}

.phone-messenger-window .messenger-btn {
    border: 0;
    border-radius: 16px;
    background: #e9edf1;
    color: #313840;
    box-shadow: none;
}

.phone-messenger-window .messenger-btn:hover {
    border: 0;
    background: #dce2e7;
}

.phone-messenger-window .messenger-btn:active {
    border: 0;
    background: #cfd6dc;
}

.phone-messenger-window .messenger-btn.icon-btn {
    width: 29px !important;
    min-width: 29px !important;
    height: 29px;
    padding: 0;
}

.phone-messenger-window .messenger-btn.icon-btn.follow::before,
.phone-messenger-window .messenger-btn.icon-btn.profile::before {
    background-position: center;
    background-repeat: no-repeat;
}

.phone-messenger-window .messenger-btn.danger {
    width: 31px;
    min-width: 31px;
    max-width: 31px;
    height: 29px;
    padding: 0;
    overflow: hidden;
    color: transparent;
    font-size: 0;
}

.phone-messenger-window .messenger-btn.danger::after {
    color: #d8485b;
    content: "!";
    font-size: 16px;
    font-weight: 700;
}

.phone-messenger-window .messenger-btn.close-btn {
    position: relative;
    width: 29px;
    min-width: 29px;
    height: 29px;
    margin: 0;
    border: 0;
    border-radius: 50%;
    background: #f1e4e6;
    color: #b53c4d;
}

.phone-messenger-window .messenger-btn.close-btn svg {
    display: block;
    margin: auto;
}


/* ------------------------------------------------------------------------
   Message conversation
   ------------------------------------------------------------------------ */

.phone-messenger-window .chat-messages {
    position: absolute;
    top: 161px;
    right: 0;
    bottom: 79px;
    left: 0;
    padding: 16px 13px 12px;
    overflow-x: hidden;
    overflow-y: auto;
    background:
        linear-gradient(rgba(247, 249, 251, .94), rgba(247, 249, 251, .94));
    scroll-behavior: smooth;
}

.phone-messenger-window:has(.messenger-typing-indicator) .chat-messages {
    bottom: 91px;
}

.phone-messenger-window .phone-message-row {
    display: flex;
    width: 100%;
    max-width: 100%;
    min-height: 0;
    align-items: flex-end;
    margin: 0 0 11px;
    gap: 7px;
}

.phone-messenger-window .phone-message-row.own {
    justify-content: flex-end;
}

.phone-messenger-window .phone-message-row.incoming {
    justify-content: flex-start;
}

.phone-messenger-window .message-avatar {
    position: relative;
    width: 34px;
    min-width: 34px;
    height: 34px;
    flex: 0 0 34px;
    overflow: hidden;
    border-radius: 50%;
    background: #e5eaef;
}

.phone-messenger-window .message-avatar .avatar-image {
    position: absolute !important;
    top: -27px !important;
    left: -27px !important;
    width: 88px !important;
    height: 120px !important;
    margin: 0 !important;
    background-position: center !important;
    background-size: auto !important;
    image-rendering: pixelated !important;
}

.phone-messenger-window .phone-message-body {
    display: flex;
    width: auto;
    max-width: 76%;
    min-width: 0;
    flex: 0 1 auto;
    flex-direction: column;
    padding: 0;
}

.phone-messenger-window .phone-message-row.own .phone-message-body {
    align-items: flex-end;
}

.phone-messenger-window .phone-message-row.incoming .phone-message-body {
    align-items: flex-start;
}

.phone-messenger-window .phone-message-name {
    height: auto;
    margin: 0 7px 3px;
    color: #7b858f;
    font-size: 9px;
    font-weight: 700;
    line-height: 12px;
}

.phone-messenger-window .phone-message-bubble {
    position: relative;
    width: auto;
    max-width: 100%;
    min-height: 34px;
    padding: 9px 12px;
    border: 0;
    border-radius: 17px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(23, 25, 29, .10);
    color: #20252a;
    overflow-wrap: anywhere;
    font-size: 12px;
    line-height: 17px;
}

.phone-messenger-window .phone-message-row.own .phone-message-bubble {
    border-bottom-right-radius: 5px;
    background: #4f8cff;
    color: #fff;
}

.phone-messenger-window .phone-message-row.incoming .phone-message-bubble {
    border-bottom-left-radius: 5px;
}

.phone-messenger-window .phone-message-bubble::after {
    display: none;
}

.phone-messenger-window .messenger-message-time {
    width: auto;
    height: auto;
    margin: 3px 7px 0;
    color: #8b949d;
    font-size: 8px;
    line-height: 11px;
}

.phone-messenger-window .phone-message-row.own .messenger-message-time {
    text-align: right;
}

.phone-messenger-window .messenger-translation-block {
    min-width: 100px;
}

.phone-messenger-window .messenger-translation-block + .messenger-translation-block {
    margin-top: 7px;
}

.phone-messenger-window .messenger-message-bubble:has(.messenger-habbicon-message) {
    padding: 8px;
    background: transparent;
    box-shadow: none;
}

.phone-messenger-window .messenger-habbicon-message {
    margin: 0;
}


/* notifications */

.phone-messenger-window .messenger-notification {
    min-height: 45px;
    margin: 8px auto;
    padding: 8px 10px;
    border: 0;
    border-radius: 14px;
    background: #e3f5ea;
    color: #326347;
    font-size: 10px;
}

.phone-messenger-window .messenger-status-notification {
    margin: 8px 0;
    color: #929aa2;
    font-size: 9px;
}


/* ------------------------------------------------------------------------
   Typing + composer
   ------------------------------------------------------------------------ */

.phone-messenger-window .messenger-typing-indicator {
    position: absolute;
    right: 18px;
    bottom: 69px;
    left: 18px;
    height: 17px;
    overflow: hidden;
    color: #7b858f;
    font-size: 9px;
    font-style: italic;
    line-height: 17px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.phone-messenger-window .phone-composer {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    height: 70px;
    align-items: center;
    padding: 10px 12px 14px;
    border-top: 1px solid #e0e4e8;
    background: #fff;
    gap: 7px;
}

.phone-messenger-window .phone-composer input {
    width: auto;
    min-width: 0;
    height: 40px;
    min-height: 40px;
    flex: 1 1 auto;
    padding: 0 14px;
    border: 1px solid #dce1e6;
    border-radius: 21px;
    outline: 0;
    background: #f1f3f5;
    color: #242a30;
    font-size: 12px;
}

.phone-messenger-window .phone-composer input:focus {
    border-color: #9cbcff;
    background: #fff;
    box-shadow: 0 0 0 3px rgba(79, 140, 255, .10);
}

.phone-messenger-window .phone-composer input::placeholder {
    color: #98a1aa;
}

.phone-messenger-window .messenger-btn.send {
    position: relative;
    width: 40px;
    min-width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #4f8cff;
    color: transparent;
    font-size: 0;
}

.phone-messenger-window .messenger-btn.send::after {
    position: absolute;
    top: 50%;
    left: 48%;
    color: #fff;
    content: "➤";
    font-family: Arial, sans-serif;
    font-size: 18px;
    line-height: 18px;
    transform: translate(-50%, -50%);
}

.phone-messenger-window .messenger-btn.send:hover {
    background: #3d7df2;
}

.phone-messenger-window .messenger-btn.send:active {
    background: #326ed7;
}

.phone-messenger-window .messenger-btn.habbicon {
    display: flex;
    width: 40px;
    min-width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #eef1f4;
}

.phone-messenger-window .messenger-btn.habbicon img {
    display: block;
    max-width: 27px;
    max-height: 27px;
}

.phone-messenger-window .messenger-btn.habbicon:hover {
    background: #e1e6eb;
}


/* ------------------------------------------------------------------------
   Habbicon popup stays functional but follows phone surface
   ------------------------------------------------------------------------ */

.phone-messenger-window .messenger-habbicon-picker {
    right: 10px;
    bottom: 67px;
    width: 300px;
    max-width: calc(100% - 20px);
    padding: 10px;
    border: 1px solid #d8dde2;
    border-radius: 18px;
    background: #fff;
    box-shadow: 0 12px 30px rgba(0, 0, 0, .20);
    image-rendering: pixelated;
}

.phone-messenger-window .messenger-habbicon-controls {
    width: 100%;
}

.phone-messenger-window .messenger-habbicon-scroll {
    width: 100%;
}

.phone-messenger-window .messenger-habbicon-scroll section {
    width: 100%;
}

.phone-messenger-window .messenger-habbicon-grid {
    width: 100%;
    grid-template-columns: repeat(5, 44px);
    justify-content: center;
}

.phone-messenger-window .messenger-habbicon-empty {
    width: 100%;
}


/* ------------------------------------------------------------------------
   Scrollbar
   ------------------------------------------------------------------------ */

.phone-messenger-window .chat-messages::-webkit-scrollbar {
    width: 5px;
}

.phone-messenger-window .chat-messages::-webkit-scrollbar-track {
    background: transparent;
}

.phone-messenger-window .chat-messages::-webkit-scrollbar-thumb {
    border-radius: 8px;
    background: #c7cdd3;
}


/* ------------------------------------------------------------------------
   Compact viewport
   ------------------------------------------------------------------------ */

@media (max-width: 520px), (max-height: 650px) {
    .phone-messenger-window {
        width: min(370px, calc(100vw - 10px));
        min-width: min(350px, calc(100vw - 10px));
        height: min(590px, calc(100vh - 10px));
        min-height: 470px;
        border-width: 5px;
        border-radius: 28px;
    }

    .phone-messenger-window .messenger-thread-header {
        height: 64px;
    }

    .phone-messenger-window .chat-messages {
        top: 155px;
    }
}
